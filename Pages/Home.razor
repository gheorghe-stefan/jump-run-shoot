@page "/"
@using System.Runtime.InteropServices
@using JumpRunShoot.Engine.Core
@using JumpRunShoot.Engine.Entities
@using JumpRunShoot.Engine.Input
@using JumpRunShoot.Engine.Themes
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>jump-run-shoot | Retro 2D Platformer</PageTitle>

<div class="game-container" style="width: 100%; max-width: 966px; margin: 0 auto;">
    <header class="game-header">
        <div class="title-group">
            <h1 class="game-title">JUMP-RUN-SHOOT</h1>
            <span class="version-badge">@GameVersion.FullDisplay</span>
        </div>
        <div class="seed-bar">
            <label for="playerNameInput">PLAYER:</label>
            <input id="playerNameInput" type="text" @bind="PlayerName" @bind:event="oninput" @bind:after="OnPlayerNameChanged" @onkeydown="OnPlayerNameKeyDown" maxlength="12" placeholder="Unknown" style="width: 85px;" />
            <label for="themeSelect">THEME:</label>
            <select id="themeSelect" class="retro-select" value="@SelectedThemeIndex" @onchange="OnThemeChanged">
                @for (int i = 0; i < ThemeRegistry.AllThemes.Length; i++)
                {
                    <option value="@i">@ThemeRegistry.AllThemes[i].Name</option>
                }
            </select>
            <label for="seedInput">WORLD SEED:</label>
            <input id="seedInput" type="text" @bind="InputSeed" @bind:event="oninput" @onkeydown="OnSeedInputKeyDown" maxlength="16" placeholder="RETRO1" />
            <button class="retro-btn" @onclick="ApplySeed">APPLY SEED</button>
            <button class="retro-btn" @onclick="RandomizeSeed">RANDOM</button>
            <button class="retro-btn" @onclick="CopyShareLink">SHARE SEED</button>
            <button class="retro-btn" @onclick="ToggleBgm" title="Toggle 1991 DOS AdLib FM Synth Background Music">@(IsMusicPlaying ? "MUSIC: ON" : "MUSIC: OFF")</button>
        </div>
    </header>

    <div class="canvas-wrapper" style="width: 100%; max-width: 966px;">
        <canvas id="gameCanvas" width="320" height="200" tabindex="0" style="width: 100%; max-width: 100%; display: block;"></canvas>
    </div>

    <section class="high-scores-section">
        <div class="scores-header">
            <h3>★ TOP OPERATORS // HALL OF FAME ★</h3>
            @if (_highScores.Count > 0)
            {
                <button class="retro-btn btn-sm" @onclick="ClearHighScores">CLEAR</button>
            }
        </div>
        @if (_highScores.Count == 0)
        {
            <div class="no-scores">NO LOCAL HIGH SCORES YET. SURVIVE, ADVANCE DEEP & CLAIM 1ST PLACE!</div>
        }
        else
        {
            <div class="scores-table-wrapper">
                <table class="retro-table">
                    <thead>
                        <tr>
                            <th>RANK</th>
                            <th>OPERATOR</th>
                            <th>SCORE</th>
                            <th>SEED</th>
                            <th>DATE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _highScores.Count; i++)
                        {
                            var s = _highScores[i];
                            <tr class="@(i == 0 ? "rank-gold" : (i == 1 ? "rank-silver" : (i == 2 ? "rank-bronze" : "")))">
                                <td>#@(i + 1)</td>
                                <td>@s.Name</td>
                                <td class="score-num">@s.Score.ToString("D6")</td>
                                <td><code>@s.Seed</code></td>
                                <td>@s.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <footer class="game-footer">
        <div class="controls-legend">
            <div class="control-col">
                <strong>CLASSIC DOS CONTROLS</strong>
                <ul>
                    <li><kbd>&larr;</kbd> <kbd>&rarr;</kbd> : Walk</li>
                    <li><kbd>&uarr;</kbd> <kbd>&darr;</kbd> : Climb Ladders</li>
                    <li><kbd>Shift</kbd> + <kbd>&larr;</kbd>/<kbd>&rarr;</kbd> : Run Fast</li>
                    <li><kbd>Ctrl</kbd> / <kbd>Space</kbd> : Jump (hold for full height)</li>
                    <li><kbd>Alt</kbd> / <kbd>X</kbd> : Shoot Blaster</li>
                    <li><kbd>&darr;</kbd> + <kbd>Ctrl</kbd> : Drop through platform</li>
                </ul>
            </div>
            <div class="control-col">
                <strong>MODERN / LAPTOP CONTROLS</strong>
                <ul>
                    <li><kbd>A</kbd> <kbd>D</kbd> : Walk</li>
                    <li><kbd>W</kbd> <kbd>S</kbd> : Climb Ladders</li>
                    <li><kbd>K</kbd> / <kbd>Shift</kbd> : Run Fast</li>
                    <li><kbd>Space</kbd> / <kbd>Z</kbd> : Jump</li>
                    <li><kbd>J</kbd> / <kbd>X</kbd> : Shoot Blaster</li>
                    <li><kbd>S</kbd> + <kbd>Space</kbd> : Drop through platform</li>
                    <li><kbd>P</kbd> : Pause (press P again to resume)</li>
                </ul>
            </div>
            <div class="control-col">
                <strong>COMBAT & VERTICAL EXPLORATION</strong>
                <ul>
                    <li>Multi-screen vertical climb: jump across scaffolding and catwalk tiers.</li>
                    <li>Player stays strictly centered; boundaries render reinforced border blocks.</li>
                    <li>Shoot patrol droids, hover drones, ceiling turrets, hounds & heavy guards.</li>
                    <li>Collect gems, med-kits & powerups (Rapid Fire, Jump Boots, Speed Dash).</li>
                    <li><strong>Lost on Damage:</strong> Active powerups are kept until taking a hit!</li>
                    <li><strong>Cheat Mode:</strong> Enter secret code (e.g. <code>DUKE</code>) in SEED & apply to unlock [G] God, [F] Fly (WASD / Arrows), [N] Noclip (walls/ceilings), [U] Powerups, [H] Heal, [K] Nuke.</li>
                </ul>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(NotificationMessage))
        {
            <div class="notification-toast">@NotificationMessage</div>
        }
    </footer>
</div>

@code {
    public sealed class HighScoreEntry
    {
        public string Name { get; set; } = "UNKNOWN";
        public int Score { get; set; }
        public string Seed { get; set; } = "RETRO1";
        public string Date { get; set; } = string.Empty;
    }

    public sealed class SaveScoreResult
    {
        public int Rank { get; set; }
        public bool IsNewHigh { get; set; }
        public List<HighScoreEntry> Scores { get; set; } = new();
    }

    private static readonly HashSet<string> CheatCodes = new(StringComparer.OrdinalIgnoreCase)
    {
        "DUKE", "APOGEE", "CHEAT", "CHEATS", "IDDQD", "KROKODIL"
    };

    private GameEngine? _engine;
    private GameLoop? _loop;
    private DotNetObjectReference<Home>? _selfRef;
    private readonly byte[] _byteBuffer = new byte[FrameBuffer.Width * FrameBuffer.Height * 4];

    public string InputSeed { get; set; } = "RETRO1";
    public string PlayerName { get; set; } = "Unknown";
    public string? NotificationMessage { get; set; }
    public int SelectedThemeIndex => _engine?.CurrentThemeIndex ?? 0;
    public string CurrentThemeName => _engine?.CurrentTheme.Name ?? "Duke 1 Classic";

    private List<HighScoreEntry> _highScores = new();
    private bool _recordedGameOverScore = false;
    public bool IsMusicPlaying { get; set; } = false;

    protected override void OnInitialized()
    {
        int queryIdx = Navigation.Uri.IndexOf('?');
        if (queryIdx >= 0)
        {
            string queryStr = Navigation.Uri.Substring(queryIdx + 1);
            foreach (string part in queryStr.Split('&'))
            {
                string[] kv = part.Split('=');
                if (kv.Length == 2 && kv[0].Equals("seed", StringComparison.OrdinalIgnoreCase))
                {
                    string decoded = Uri.UnescapeDataString(kv[1]);
                    if (!string.IsNullOrWhiteSpace(decoded))
                    {
                        InputSeed = decoded;
                    }
                    break;
                }
            }
        }

        _engine = new GameEngine(InputSeed);
        _loop = new GameLoop(_engine);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _engine != null && _loop != null)
        {
            _selfRef = DotNetObjectReference.Create(this);
            bool success = await JSRuntime.InvokeAsync<bool>("gameInterop.init", "gameCanvas", _selfRef);
            if (success)
            {
                try
                {
                    string savedName = await JSRuntime.InvokeAsync<string>("gameInterop.getPlayerName");
                    if (!string.IsNullOrWhiteSpace(savedName))
                    {
                        PlayerName = savedName;
                        _engine.PlayerName = PlayerName;
                    }

                    _highScores = await JSRuntime.InvokeAsync<List<HighScoreEntry>>("gameInterop.getHighScores") ?? new();
                    StateHasChanged();
                }
                catch { }

                _loop.Start();
                await JSRuntime.InvokeVoidAsync("gameInterop.startLoop");
            }
        }
    }

    private async Task OnPlayerNameChanged()
    {
        string name = string.IsNullOrWhiteSpace(PlayerName) ? "Unknown" : PlayerName.Trim();
        if (_engine != null)
        {
            _engine.PlayerName = name;
        }
        await JSRuntime.InvokeVoidAsync("gameInterop.setPlayerName", name);
    }

    private async Task OnPlayerNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            await JSRuntime.InvokeVoidAsync("gameInterop.focusCanvas");
        }
    }

    private async Task OnSeedInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            await ApplySeed();
        }
    }

    private async Task ToggleBgm()
    {
        IsMusicPlaying = await JSRuntime.InvokeAsync<bool>("gameInterop.bgm.toggle");
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAnimationFrame(double timestamp)
    {
        if (_loop == null || _engine == null) return;

        _loop.Tick(timestamp);

        if (_engine.IsGameOver && !_recordedGameOverScore)
        {
            _recordedGameOverScore = true;
            _ = RecordGameOverScore();
        }
        else if (!_engine.IsGameOver && _recordedGameOverScore)
        {
            _recordedGameOverScore = false;
        }

        int audioFlags = _engine.ConsumeAudioFlags();
        MemoryMarshal.AsBytes(_engine.FrameBuffer.Pixels.AsSpan()).CopyTo(_byteBuffer);
        _ = JSRuntime.InvokeVoidAsync("gameInterop.renderFrame", _byteBuffer, audioFlags);
    }

    private async Task RecordGameOverScore()
    {
        if (_engine == null || _engine.Player.Score <= 0) return;
        try
        {
            var res = await JSRuntime.InvokeAsync<SaveScoreResult>("gameInterop.saveHighScore", _engine.PlayerName, _engine.Player.Score, _engine.CurrentSeed);
            if (res != null)
            {
                _highScores = res.Scores;
                if (res.Rank > 0 && res.Rank <= 10)
                {
                    string msg = res.IsNewHigh
                        ? $"★ NEW ALL-TIME HIGH SCORE! 1ST PLACE: {_engine.Player.Score:D6} PTS ★"
                        : $"★ HALL OF FAME: RANK #{res.Rank} WITH {_engine.Player.Score:D6} PTS! ★";
                    ShowNotification(msg);
                }
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task ClearHighScores()
    {
        await JSRuntime.InvokeVoidAsync("gameInterop.clearHighScores");
        _highScores.Clear();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnKeyDown(string code) => _engine?.Input.HandleKeyDown(code);

    [JSInvokable]
    public void OnKeyUp(string code) => _engine?.Input.HandleKeyUp(code);

    [JSInvokable]
    public void OnBlur() => _engine?.Input.Reset();

    private async Task ApplySeed()
    {
        string trimmed = (InputSeed ?? string.Empty).Trim();
        if (CheatCodes.Contains(trimmed))
        {
            if (_engine != null)
            {
                _engine.CheatsEnabled = true;
                _engine.ShowNotification("CHEAT MODE ENABLED! [G] [F] [N] [U] [H] [K]", 4.0f, EgaColorIndex.Yellow);
                InputSeed = _engine.CurrentSeed;
            }
            await JSRuntime.InvokeVoidAsync("gameInterop.focusCanvas");
            ShowNotification("CHEAT CODE UNLOCKED! Press [G] God, [F] Fly, [N] Noclip, [U] Powerups, [H] Heal, [K] Nuke");
            return;
        }

        if (string.IsNullOrWhiteSpace(InputSeed)) InputSeed = "RETRO1";
        _engine?.Restart(InputSeed);
        await JSRuntime.InvokeVoidAsync("gameInterop.focusCanvas");
        ShowNotification($"Seed set to '{InputSeed}'. Endless world regenerated!");
    }

    private async Task RandomizeSeed()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var rng = new Random();
        char[] seedChars = new char[6];
        for (int i = 0; i < seedChars.Length; i++)
        {
            seedChars[i] = chars[rng.Next(chars.Length)];
        }
        InputSeed = new string(seedChars);
        await ApplySeed();
    }

    private async Task CopyShareLink()
    {
        string shareUrl = Navigation.GetUriWithQueryParameter("seed", InputSeed);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
        ShowNotification("Shareable game link copied to clipboard!");
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int themeIdx))
        {
            _engine?.SetTheme(themeIdx);
            await JSRuntime.InvokeVoidAsync("gameInterop.focusCanvas");
            ShowNotification($"Switched visual theme to '{CurrentThemeName}'!");
        }
    }

    private void ShowNotification(string msg)
    {
        NotificationMessage = msg;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            NotificationMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        _loop?.Stop();
        _ = JSRuntime.InvokeVoidAsync("gameInterop.stopLoop");
        _selfRef?.Dispose();
    }
}
